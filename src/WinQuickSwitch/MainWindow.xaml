<Window x:Class="WinQuickSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinQuickSwitch"
        Width="500"
        MinWidth="460"
        MinHeight="0"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{DynamicResource PageBrush}"
        Loaded="MainWindow_Loaded"
        SizeChanged="MainWindow_SizeChanged"
        Closing="MainWindow_Closing"
        Deactivated="MainWindow_Deactivated"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <UniformGrid Grid.Column="0" Columns="6">
          <ToggleButton x:Name="DisplayPanelTab"
                        Style="{StaticResource WidgetTabToggle}"
                        Tag="Display"
                        IsChecked="True"
                        Checked="PanelTab_Checked"
                        Content="Display"
                        AutomationProperties.Name="Open display controls" />
          <ToggleButton x:Name="AudioPanelTab"
                        Style="{StaticResource WidgetTabToggle}"
                        Tag="Audio"
                        Checked="PanelTab_Checked"
                        Content="Audio"
                        AutomationProperties.Name="Open audio controls" />
          <ToggleButton x:Name="DevicesPanelTab"
                        Style="{StaticResource WidgetTabToggle}"
                        Tag="Devices"
                        Checked="PanelTab_Checked"
                        Content="Devices"
                        AutomationProperties.Name="Open connected devices" />
          <ToggleButton x:Name="OptionsPanelTab"
                        Style="{StaticResource WidgetTabToggle}"
                        Tag="Options"
                        Checked="PanelTab_Checked"
                        Content="Options"
                        AutomationProperties.Name="Open widget options" />
          <ToggleButton x:Name="ProfilesPanelTab"
                        Style="{StaticResource WidgetTabToggle}"
                        Tag="Profiles"
                        Checked="PanelTab_Checked"
                        Content="Profiles"
                        AutomationProperties.Name="Open saved profiles" />
          <ToggleButton x:Name="AboutPanelTab"
                        Style="{StaticResource WidgetTabToggle}"
                        Tag="About"
                        Checked="PanelTab_Checked"
                        Content="About"
                        AutomationProperties.Name="Open About and disclaimer" />
        </UniformGrid>
        <Button Grid.Column="1"
                Style="{StaticResource CompactButton}"
                Margin="0,0,0,8"
                Click="Quit_Click"
                Content="Quit"
                ToolTip="Exit WinQuickSwitch completely" />
      </Grid>

      <Border x:Name="DisplayPanel"
              Grid.Row="1"
              Style="{StaticResource SectionCard}">
        <StackPanel>
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="Display" />

          <UniformGrid x:Name="DisplayModeButtons"
                       Margin="0,12,0,2"
                       Columns="2"
                       KeyboardNavigation.TabNavigation="Continue">
            <ToggleButton Style="{StaticResource DisplayModeToggle}"
                          Tag="PcScreenOnly"
                          Click="ApplyDisplayMode_Click"
                          Content="PC screen only"
                          AutomationProperties.Name="PC screen only display mode"
                          ToolTip="Use the primary PC display only" />
            <ToggleButton Style="{StaticResource DisplayModeToggle}"
                          x:Name="DuplicateDisplayButton"
                          Tag="Duplicate"
                          Click="ApplyDisplayMode_Click"
                          Content="Duplicate"
                          AutomationProperties.Name="Duplicate display mode"
                          ToolTip="Show the same desktop on each display" />
            <ToggleButton Style="{StaticResource DisplayModeToggle}"
                          x:Name="ExtendDisplayButton"
                          Tag="Extend"
                          Click="ApplyDisplayMode_Click"
                          Content="Extend"
                          AutomationProperties.Name="Extend display mode"
                          ToolTip="Extend the desktop across displays" />
            <ToggleButton Style="{StaticResource DisplayModeToggle}"
                          Tag="SecondScreenOnly"
                          Click="ApplyDisplayMode_Click"
                          Content="Second screen only"
                          AutomationProperties.Name="Second screen only display mode"
                          ToolTip="Use the external display only" />
          </UniformGrid>

          <TextBlock x:Name="DisplayStatusText"
                     Margin="0,4,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Choose a projection mode." />
        </StackPanel>
      </Border>

      <Border x:Name="AudioPanel"
              Grid.Row="1"
              Style="{StaticResource SectionCard}"
              Visibility="Collapsed">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="Audio" />
            <WrapPanel Grid.Column="1">
              <Button x:Name="OpenVolumeMixerButton"
                      Style="{StaticResource CompactButton}"
                      Click="OpenVolumeMixer_Click"
                      Content="Volume mixer"
                      ToolTip="Open the Windows app volume mixer" />
              <Button x:Name="OpenSoundSettingsButton"
                      Style="{StaticResource CompactButton}"
                      Click="OpenSoundSettings_Click"
                      Content="Sound settings"
                      ToolTip="Open the general Windows System > Sound page" />
              <Button x:Name="RefreshAudioButton"
                      MinWidth="78"
                      MinHeight="32"
                      Padding="10,4"
                      Click="RefreshAudio_Click"
                      Content="Refresh" />
            </WrapPanel>
          </Grid>

          <TextBlock x:Name="AudioStatusText"
                     Margin="0,8,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Loading..." />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Text="Output" />
              <ListBox x:Name="PlaybackEndpointsList"
                       MinHeight="72"
                       MaxHeight="135"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid AutomationProperties.Name="{Binding Name}"
                          AutomationProperties.HelpText="{Binding ActiveRoleDescription}"
                          ToolTip="{Binding ActiveRoleDescription}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1"
                              Background="{DynamicResource DefaultBadgeBrush}">
                        <Border.Style>
                          <Style TargetType="Border"
                                 BasedOn="{StaticResource EndpointBadge}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="DEFAULT" />
                      </Border>
                      <Border Grid.Column="2"
                              Background="{DynamicResource CallsBadgeBrush}">
                        <Border.Style>
                          <Style TargetType="Border"
                                 BasedOn="{StaticResource EndpointBadge}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCommunicationsDefault}"
                                           Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="CALLS" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel Margin="0,8,0,0">
                <ComboBox x:Name="PlaybackFavoriteRoleBox"
                          Width="82"
                          Margin="0,0,6,0"
                          SelectedIndex="0"
                          ToolTip="Choose which Windows audio roles this favorite changes">
                  <ComboBoxItem Tag="General" Content="Default" />
                  <ComboBoxItem Tag="Communications" Content="Calls" />
                  <ComboBoxItem Tag="Both" Content="Both" />
                </ComboBox>
                <Button Style="{StaticResource CompactButton}"
                        Tag="PlaybackGeneral"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Default"
                        ToolTip="Use the selected playback device for normal Windows audio" />
                <Button Style="{StaticResource CompactButton}"
                        Tag="PlaybackCommunications"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Calls"
                        ToolTip="Set the selected device as Windows' calls default; apps can override it" />
                <Button Style="{StaticResource CompactButton}"
                        Click="AddFavoriteOutput_Click"
                        Content="Add favorite"
                        ToolTip="Save the selected output as a favorite" />
                <Button Style="{StaticResource CompactButton}"
                        Click="RemoveFavoriteOutput_Click"
                        Content="Remove"
                        ToolTip="Remove the selected output from favorites" />
              </WrapPanel>
              <TextBlock x:Name="FavoriteOutputsSummaryText"
                         Margin="0,6,0,0"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Text="Favorites: none"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Text="Input" />
              <ListBox x:Name="RecordingEndpointsList"
                       MinHeight="72"
                       MaxHeight="135"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemTemplate="{Binding ElementName=PlaybackEndpointsList, Path=ItemTemplate}" />
              <WrapPanel Margin="0,8,0,0">
                <ComboBox x:Name="RecordingFavoriteRoleBox"
                          Width="82"
                          Margin="0,0,6,0"
                          SelectedIndex="0"
                          ToolTip="Choose which Windows audio roles this favorite changes">
                  <ComboBoxItem Tag="General" Content="Default" />
                  <ComboBoxItem Tag="Communications" Content="Calls" />
                  <ComboBoxItem Tag="Both" Content="Both" />
                </ComboBox>
                <Button Style="{StaticResource CompactButton}"
                        Tag="RecordingGeneral"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Default"
                        ToolTip="Use the selected microphone for normal recording" />
                <Button Style="{StaticResource CompactButton}"
                        Tag="RecordingCommunications"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Calls"
                        ToolTip="Set the selected microphone as Windows' calls default; apps can override it" />
                <Button Style="{StaticResource CompactButton}"
                        Click="AddFavoriteInput_Click"
                        Content="Add favorite"
                        ToolTip="Save the selected microphone as a favorite" />
                <Button Style="{StaticResource CompactButton}"
                        Click="RemoveFavoriteInput_Click"
                        Content="Remove"
                        ToolTip="Remove the selected microphone from favorites" />
              </WrapPanel>
              <TextBlock x:Name="FavoriteInputsSummaryText"
                         Margin="0,6,0,0"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Text="Favorites: none"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            </StackPanel>
          </Grid>

          <TextBlock Margin="0,12,0,6"
                     FontWeight="SemiBold"
                     Text="App volumes" />
          <ListView x:Name="AudioSessionsList"
                    MinHeight="72"
                    MaxHeight="115"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="95"
                                Header="Application"
                                DisplayMemberBinding="{Binding ApplicationName}" />
                <GridViewColumn Width="105"
                                Header="Output"
                                DisplayMemberBinding="{Binding EndpointName}" />
                <GridViewColumn Width="155" Header="Volume">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="98" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="2"
                                LargeChange="10"
                                Tag="{Binding Id}"
                                Value="{Binding VolumePercent, Mode=OneWay}"
                                PreviewMouseLeftButtonUp="SessionVolumeSlider_Commit"
                                KeyUp="SessionVolumeSlider_KeyUp"
                                AutomationProperties.Name="{Binding ApplicationName, StringFormat=Volume for {0}}" />
                        <TextBlock Grid.Column="1"
                                   Width="42"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding VolumeLabel}" />
                      </Grid>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="55" Header="Mute">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox HorizontalAlignment="Center"
                                Tag="{Binding Id}"
                                IsChecked="{Binding IsMuted, Mode=OneWay}"
                                Click="SessionMute_Click"
                                AutomationProperties.Name="{Binding ApplicationName, StringFormat=Mute {0}}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </StackPanel>
      </Border>

      <Border x:Name="DevicesPanel"
              Grid.Row="1"
              Style="{StaticResource SectionCard}"
              Visibility="Collapsed">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="Devices" />
            <Button x:Name="RefreshDevicesButton"
                    Grid.Column="1"
                    MinWidth="78"
                    MinHeight="32"
                    Padding="10,4"
                    Click="RefreshDevices_Click"
                    Content="Refresh" />
          </Grid>

          <TextBlock x:Name="DeviceStatusText"
                     Margin="0,8,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Loading..." />

          <UniformGrid Margin="0,10,0,0" Columns="2">
            <ToggleButton x:Name="WiFiRadioToggle"
                          Style="{StaticResource DisplayModeToggle}"
                          Margin="0,0,6,0"
                          Tag="WiFi"
                          Click="WirelessRadioToggle_Click"
                          Content="Wi-Fi unavailable"
                          AutomationProperties.Name="Toggle Wi-Fi" />
            <ToggleButton x:Name="BluetoothRadioToggle"
                          Style="{StaticResource DisplayModeToggle}"
                          Margin="6,0,0,0"
                          Tag="Bluetooth"
                          Click="WirelessRadioToggle_Click"
                          Content="Bluetooth unavailable"
                          AutomationProperties.Name="Toggle Bluetooth" />
          </UniformGrid>

          <TextBlock x:Name="WirelessStatusText"
                     Margin="0,7,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />

          <ListView x:Name="ConnectedDevicesList"
                    Margin="0,10,0,0"
                    MinHeight="80"
                    MaxHeight="145"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="165"
                                Header="Name"
                                DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Width="75"
                                Header="Connection"
                                DisplayMemberBinding="{Binding ConnectionLabel}" />
                <GridViewColumn Width="85"
                                Header="Type"
                                DisplayMemberBinding="{Binding Category}" />
                <GridViewColumn Width="80"
                                Header="Status"
                                DisplayMemberBinding="{Binding StatusLabel}" />
              </GridView>
            </ListView.View>
          </ListView>

          <WrapPanel Margin="0,10,0,0">
            <Button Style="{StaticResource CompactButton}"
                    Click="OpenWiFiSettings_Click"
                    Content="Wi-Fi settings"
                    ToolTip="Manage Wi-Fi networks in Windows Settings" />
            <Button Style="{StaticResource CompactButton}"
                    Click="OpenBluetoothSettings_Click"
                    Content="Bluetooth settings"
                    ToolTip="Pair, disconnect, or remove a Bluetooth device in Windows Settings" />
            <Button Style="{StaticResource CompactButton}"
                    Click="OpenAirplaneModeSettings_Click"
                    Content="Airplane mode"
                    ToolTip="Open Windows airplane mode settings" />
            <Button Style="{StaticResource CompactButton}"
                    Click="OpenNetworkSettings_Click"
                    Content="Network"
                    ToolTip="Open Windows network status settings" />
            <Button Style="{StaticResource CompactButton}"
                    Click="OpenConnectedDevicesSettings_Click"
                    Content="Devices settings"
                    ToolTip="Manage connected devices in Windows Settings" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border x:Name="OptionsPanel"
              Grid.Row="1"
              Style="{StaticResource SectionCard}"
              Visibility="Collapsed">
        <StackPanel>
          <TextBlock FontSize="17"
                     FontWeight="SemiBold"
                     Text="Options" />
          <TextBlock Margin="0,5,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Select a field, then press a shortcut, or choose Unset."
                     TextWrapping="Wrap" />

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="115" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="68" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="0,0,8,8"
                       VerticalAlignment="Center"
                       Text="Show / hide" />
            <TextBox x:Name="ToggleShortcutBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,0,6,8"
                     IsReadOnly="True"
                     Tag="ToggleWidget"
                     AutomationProperties.Name="Show or hide shortcut" />
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource CompactButton}"
                    Tag="ToggleWidget"
                    Click="UnsetShortcut_Click"
                    Content="Unset"
                    AutomationProperties.Name="Unset show or hide shortcut" />

            <TextBlock Grid.Row="1"
                       Margin="0,0,8,8"
                       VerticalAlignment="Center"
                       Text="Open Display" />
            <TextBox x:Name="DisplayShortcutBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,0,6,8"
                     IsReadOnly="True"
                     Tag="Display"
                     AutomationProperties.Name="Open Display shortcut" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource CompactButton}"
                    Tag="Display"
                    Click="UnsetShortcut_Click"
                    Content="Unset"
                    AutomationProperties.Name="Unset Open Display shortcut" />

            <TextBlock Grid.Row="2"
                       Margin="0,0,8,8"
                       VerticalAlignment="Center"
                       Text="Open Audio" />
            <TextBox x:Name="AudioShortcutBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,0,6,8"
                     IsReadOnly="True"
                     Tag="Audio"
                     AutomationProperties.Name="Open Audio shortcut" />
            <Button Grid.Row="2"
                    Grid.Column="2"
                    Style="{StaticResource CompactButton}"
                    Tag="Audio"
                    Click="UnsetShortcut_Click"
                    Content="Unset"
                    AutomationProperties.Name="Unset Open Audio shortcut" />

            <TextBlock Grid.Row="3"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="Open Devices" />
            <TextBox x:Name="DevicesShortcutBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Margin="0,0,6,0"
                     IsReadOnly="True"
                     Tag="Devices"
                     AutomationProperties.Name="Open Devices shortcut" />
            <Button Grid.Row="3"
                    Grid.Column="2"
                    Style="{StaticResource CompactButton}"
                    Tag="Devices"
                    Click="UnsetShortcut_Click"
                    Content="Unset"
                    AutomationProperties.Name="Unset Open Devices shortcut" />
          </Grid>

          <Expander x:Name="DisplayModeShortcutsExpander"
                    Margin="0,12,0,0"
                    Header="Display mode shortcuts">
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="135" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="68" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"
                         Margin="0,0,8,8"
                         VerticalAlignment="Center"
                         Text="PC screen only" />
              <TextBox x:Name="PcScreenOnlyShortcutBox"
                       Grid.Row="0"
                       Grid.Column="1"
                       Margin="0,0,6,8"
                       IsReadOnly="True"
                       Tag="PcScreenOnly"
                       AutomationProperties.Name="PC screen only shortcut" />
              <Button Grid.Row="0"
                      Grid.Column="2"
                      Style="{StaticResource CompactButton}"
                      Tag="PcScreenOnly"
                      Click="UnsetShortcut_Click"
                      Content="Unset"
                      AutomationProperties.Name="Unset PC screen only shortcut" />

              <TextBlock Grid.Row="1"
                         Margin="0,0,8,8"
                         VerticalAlignment="Center"
                         Text="Duplicate" />
              <TextBox x:Name="DuplicateShortcutBox"
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="0,0,6,8"
                       IsReadOnly="True"
                       Tag="Duplicate"
                       AutomationProperties.Name="Duplicate shortcut" />
              <Button Grid.Row="1"
                      Grid.Column="2"
                      Style="{StaticResource CompactButton}"
                      Tag="Duplicate"
                      Click="UnsetShortcut_Click"
                      Content="Unset"
                      AutomationProperties.Name="Unset Duplicate shortcut" />

              <TextBlock Grid.Row="2"
                         Margin="0,0,8,8"
                         VerticalAlignment="Center"
                         Text="Extend" />
              <TextBox x:Name="ExtendShortcutBox"
                       Grid.Row="2"
                       Grid.Column="1"
                       Margin="0,0,6,8"
                       IsReadOnly="True"
                       Tag="Extend"
                       AutomationProperties.Name="Extend shortcut" />
              <Button Grid.Row="2"
                      Grid.Column="2"
                      Style="{StaticResource CompactButton}"
                      Tag="Extend"
                      Click="UnsetShortcut_Click"
                      Content="Unset"
                      AutomationProperties.Name="Unset Extend shortcut" />

              <TextBlock Grid.Row="3"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Text="Second screen only" />
              <TextBox x:Name="SecondScreenOnlyShortcutBox"
                       Grid.Row="3"
                       Grid.Column="1"
                       Margin="0,0,6,0"
                       IsReadOnly="True"
                       Tag="SecondScreenOnly"
                       AutomationProperties.Name="Second screen only shortcut" />
              <Button Grid.Row="3"
                      Grid.Column="2"
                      Style="{StaticResource CompactButton}"
                      Tag="SecondScreenOnly"
                      Click="UnsetShortcut_Click"
                      Content="Unset"
                      AutomationProperties.Name="Unset Second screen only shortcut" />
            </Grid>
          </Expander>

          <Expander x:Name="FavoriteOutputShortcutsExpander"
                    Margin="0,8,0,0"
                    Header="Favorite output shortcuts">
            <StackPanel Margin="0,8,0,0">
              <TextBlock x:Name="FavoriteOutputsEmptyText"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Text="In Audio, select an output and choose Add favorite."
                         TextWrapping="Wrap" />
              <ItemsControl x:Name="FavoriteOutputShortcutItems">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="58" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Name}" />
                      <TextBox Grid.Column="1"
                               Margin="0,0,6,0"
                               Tag="{Binding Action}"
                               Text="{Binding Alias, Mode=OneWay}"
                               LostFocus="FavoriteAlias_LostFocus"
                               ToolTip="Optional favorite alias"
                               AutomationProperties.Name="{Binding Name, StringFormat=Alias for {0}}" />
                      <Button Grid.Column="2"
                              Margin="0,0,4,0"
                              Padding="2,4"
                              Style="{StaticResource CompactButton}"
                              Tag="{Binding Action}"
                              Click="MoveFavoriteUp_Click"
                              Content="↑"
                              ToolTip="Move favorite up"
                              AutomationProperties.Name="Move favorite up" />
                      <Button Grid.Column="3"
                              Margin="0,0,4,0"
                              Padding="2,4"
                              Style="{StaticResource CompactButton}"
                              Tag="{Binding Action}"
                              Click="MoveFavoriteDown_Click"
                              Content="↓"
                              ToolTip="Move favorite down"
                              AutomationProperties.Name="Move favorite down" />
                      <TextBox Grid.Column="4"
                               Margin="0,0,6,0"
                               IsReadOnly="True"
                               Tag="{Binding Action}"
                               Text="{Binding ShortcutText, Mode=OneWay}"
                               AutomationProperties.Name="{Binding EditorName}" />
                      <Button Grid.Column="5"
                              Style="{StaticResource CompactButton}"
                              Tag="{Binding Action}"
                              Click="UnsetShortcut_Click"
                              Content="Unset"
                              AutomationProperties.Name="{Binding EditorName, StringFormat=Unset {0}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>

          <Expander x:Name="FavoriteInputShortcutsExpander"
                    Margin="0,8,0,0"
                    Header="Favorite microphone shortcuts">
            <StackPanel Margin="0,8,0,0">
              <TextBlock x:Name="FavoriteInputsEmptyText"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Text="In Audio, select a microphone and choose Add favorite."
                         TextWrapping="Wrap" />
              <ItemsControl x:Name="FavoriteInputShortcutItems">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="58" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Name}" />
                      <TextBox Grid.Column="1"
                               Margin="0,0,6,0"
                               Tag="{Binding Action}"
                               Text="{Binding Alias, Mode=OneWay}"
                               LostFocus="FavoriteAlias_LostFocus"
                               ToolTip="Optional favorite alias"
                               AutomationProperties.Name="{Binding Name, StringFormat=Alias for {0}}" />
                      <Button Grid.Column="2"
                              Margin="0,0,4,0"
                              Padding="2,4"
                              Style="{StaticResource CompactButton}"
                              Tag="{Binding Action}"
                              Click="MoveFavoriteUp_Click"
                              Content="↑"
                              ToolTip="Move favorite up"
                              AutomationProperties.Name="Move favorite up" />
                      <Button Grid.Column="3"
                              Margin="0,0,4,0"
                              Padding="2,4"
                              Style="{StaticResource CompactButton}"
                              Tag="{Binding Action}"
                              Click="MoveFavoriteDown_Click"
                              Content="↓"
                              ToolTip="Move favorite down"
                              AutomationProperties.Name="Move favorite down" />
                      <TextBox Grid.Column="4"
                               Margin="0,0,6,0"
                               IsReadOnly="True"
                               Tag="{Binding Action}"
                               Text="{Binding ShortcutText, Mode=OneWay}"
                               AutomationProperties.Name="{Binding EditorName}" />
                      <Button Grid.Column="5"
                              Style="{StaticResource CompactButton}"
                              Tag="{Binding Action}"
                              Click="UnsetShortcut_Click"
                              Content="Unset"
                              AutomationProperties.Name="{Binding EditorName, StringFormat=Unset {0}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>

          <StackPanel Margin="0,14,0,0">
            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Text="Taskbar" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Show it, or enable Windows auto-hide."
                       TextWrapping="Wrap" />
            <UniformGrid Margin="0,8,0,0" Columns="2">
              <Button Style="{StaticResource CompactButton}"
                      Click="ShowTaskbar_Click"
                      Content="Show taskbar"
                      ToolTip="Turn off taskbar auto-hide" />
              <Button Style="{StaticResource CompactButton}"
                      Click="HideTaskbar_Click"
                      Content="Hide taskbar"
                      ToolTip="Enable Windows taskbar auto-hide" />
            </UniformGrid>
            <WrapPanel Margin="0,2,0,0">
              <Button Style="{StaticResource CompactButton}"
                      Click="OpenTaskbarSettings_Click"
                      Content="Taskbar settings" />
              <Button Style="{StaticResource CompactButton}"
                      Click="OpenTaskbarDisplaySettings_Click"
                      Content="Display settings"
                      ToolTip="Configure taskbar behavior across displays" />
              <Button Style="{StaticResource CompactButton}"
                      Click="OpenTaskbarNotificationSettings_Click"
                      Content="Notifications"
                      ToolTip="Configure notification-area behavior" />
            </WrapPanel>
            <TextBlock x:Name="TaskbarStatusText"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Taskbar state is loading..."
                       TextWrapping="Wrap" />
          </StackPanel>

          <CheckBox x:Name="DarkThemeCheckBox"
                    Margin="0,14,0,0"
                    Checked="DarkThemeCheckBox_Changed"
                    Unchecked="DarkThemeCheckBox_Changed"
                    Content="Use dark theme" />

          <CheckBox x:Name="StartWithWindowsCheckBox"
                    Margin="0,10,0,0"
                    Checked="StartWithWindowsCheckBox_Changed"
                    Unchecked="StartWithWindowsCheckBox_Changed"
                    Content="Start WinQuickSwitch when I sign in"
                    ToolTip="Starts hidden and waits for your shortcut" />

          <WrapPanel Margin="0,12,0,0">
            <Button Style="{StaticResource CompactButton}"
                    Click="ResetShortcuts_Click"
                    Content="Reset shortcuts" />
          </WrapPanel>

          <TextBlock x:Name="OptionsStatusText"
                     Margin="0,10,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Settings are saved automatically."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border x:Name="ProfilesPanel"
              Grid.Row="1"
              Style="{StaticResource SectionCard}"
              Visibility="Collapsed">
        <StackPanel>
          <TextBlock FontSize="17"
                     FontWeight="SemiBold"
                     Text="Profiles" />
          <TextBlock Margin="0,5,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Save the settings that define a desk mode. Unchecked items stay unchanged when you apply it."
                     TextWrapping="Wrap" />

          <TextBox x:Name="ProfileNameBox"
                   Margin="0,12,0,0"
                   MinHeight="32"
                   Padding="8,5"
                   Text="New profile"
                   AutomationProperties.Name="Profile name" />

          <UniformGrid Margin="0,10,0,0"
                       Columns="2">
            <CheckBox x:Name="ProfileIncludeDisplayCheckBox"
                      Margin="0,0,8,8"
                      IsChecked="True"
                      Content="Display mode" />
            <CheckBox x:Name="ProfileIncludeTaskbarCheckBox"
                      Margin="0,0,0,8"
                      IsChecked="True"
                      Content="Taskbar" />
            <CheckBox x:Name="ProfileIncludePlaybackCheckBox"
                      Margin="0,0,8,0"
                      IsChecked="True"
                      Content="Playback" />
            <CheckBox x:Name="ProfileIncludeRecordingCheckBox"
                      IsChecked="True"
                      Content="Recording" />
          </UniformGrid>

          <TextBlock Margin="0,10,0,0"
                     FontWeight="SemiBold"
                     Text="Favorite targets" />
          <TextBlock Margin="0,3,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Optionally use a saved favorite when capturing audio."
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,8,0,0"
                     Text="Playback favorite (optional)" />
          <ComboBox x:Name="ProfilePlaybackFavoriteBox"
                    Margin="0,4,0,0"
                    DisplayMemberPath="Name"
                    SelectedIndex="0" />
          <TextBlock Margin="0,8,0,0"
                     Text="Microphone favorite (optional)" />
          <ComboBox x:Name="ProfileRecordingFavoriteBox"
                    Margin="0,4,0,0"
                    DisplayMemberPath="Name"
                    SelectedIndex="0" />

          <CheckBox x:Name="ProfilePinCheckBox"
                    Margin="0,8,0,0"
                    Content="Pin after saving" />
          <Button x:Name="SaveProfileButton"
                  Margin="0,10,0,0"
                  HorizontalAlignment="Left"
                  Style="{StaticResource CompactButton}"
                  Click="SaveCurrentProfile_Click"
                  Content="Save current setup" />
          <Button x:Name="CancelProfileEditButton"
                  Margin="0,6,0,0"
                  HorizontalAlignment="Left"
                  Style="{StaticResource CompactButton}"
                  Click="CancelProfileEdit_Click"
                  Content="Cancel edit"
                  Visibility="Collapsed" />
          <Button x:Name="UndoProfileButton"
                  Margin="0,6,0,0"
                  HorizontalAlignment="Left"
                  Style="{StaticResource CompactButton}"
                  Click="UndoProfile_Click"
                  Content="Undo last profile"
                  Visibility="Collapsed" />

          <TextBlock x:Name="ProfileEmptyText"
                     Margin="0,14,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="No profiles saved yet."
                     TextWrapping="Wrap" />
          <ItemsControl x:Name="ProfileItems"
                        Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,8"
                        Padding="8"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="132" />
                      <ColumnDefinition Width="58" />
                      <ColumnDefinition Width="58" />
                      <ColumnDefinition Width="58" />
                      <ColumnDefinition Width="58" />
                      <ColumnDefinition Width="58" />
                      <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock FontWeight="SemiBold"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Name}" />
                      <TextBlock Margin="0,3,0,0"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 Text="{Binding Summary}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Margin="0,0,4,0"
                             MinHeight="28"
                             Padding="5,3"
                             HorizontalContentAlignment="Center"
                             IsReadOnly="True"
                             Text="{Binding ShortcutText}"
                             Tag="{Binding Id}"
                             PreviewKeyDown="ProfileShortcut_PreviewKeyDown"
                             ToolTip="Click here, then press a shortcut. Delete clears it." />
                    <Button Grid.Column="2"
                            Margin="0,0,4,0"
                            Style="{StaticResource CompactButton}"
                            Tag="{Binding Id}"
                            Click="UnsetProfileShortcut_Click"
                            Content="Unset"
                            ToolTip="Clear this profile shortcut" />
                    <Button Grid.Column="3"
                            Margin="0,0,4,0"
                            Style="{StaticResource CompactButton}"
                            Tag="{Binding Id}"
                            Click="ApplyProfile_Click"
                            Content="Apply"
                            ToolTip="Apply this profile" />
                    <Button Grid.Column="4"
                            Margin="0,0,4,0"
                            Style="{StaticResource CompactButton}"
                            Tag="{Binding Id}"
                            Click="EditProfile_Click"
                            Content="Edit"
                            ToolTip="Edit this profile" />
                    <Button Grid.Column="5"
                            Margin="0,0,4,0"
                            Style="{StaticResource CompactButton}"
                            Tag="{Binding Id}"
                            Click="DuplicateProfile_Click"
                            Content="Copy"
                            ToolTip="Duplicate this profile" />
                    <Button Grid.Column="6"
                            Margin="0,0,4,0"
                            Style="{StaticResource CompactButton}"
                            Tag="{Binding Id}"
                            Click="ToggleProfilePin_Click"
                            Content="{Binding PinLabel}"
                            ToolTip="Pin or unpin this profile" />
                    <Button Grid.Column="7"
                            Style="{StaticResource CompactButton}"
                            Tag="{Binding Id}"
                            Click="DeleteProfile_Click"
                            Content="Delete"
                            ToolTip="Delete this profile" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="ProfilesStatusText"
                     Margin="0,6,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Profiles are saved locally."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border x:Name="AboutPanel"
              Grid.Row="1"
              Style="{StaticResource SectionCard}"
              Visibility="Collapsed">
        <StackPanel>
          <TextBlock FontSize="17"
                     FontWeight="SemiBold"
                     Text="About WinQuickSwitch" />
          <TextBlock Margin="0,5,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="A local Windows utility for quick display, audio, device, taskbar, favorite, and profile controls."
                     TextWrapping="Wrap" />

          <Border Margin="0,14,0,0"
                  Padding="10"
                  Background="{DynamicResource SelectionBrush}"
                  CornerRadius="5">
            <StackPanel>
              <TextBlock FontWeight="SemiBold"
                         Foreground="{DynamicResource SelectionTextBrush}"
                         Text="Do not share this application" />
              <TextBlock Margin="0,5,0,0"
                         Foreground="{DynamicResource SelectionTextBrush}"
                         Text="This build is intended for its authorized user. Do not copy, upload, redistribute, or publish the EXE or packaged application without permission."
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,5,0,0"
                         Foreground="{DynamicResource SelectionTextBrush}"
                         Text="Keep local settings, saved profiles, device names, and shortcuts private."
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TextBlock Margin="0,14,0,0"
                     FontWeight="SemiBold"
                     Text="Use responsibly" />
          <TextBlock Margin="0,4,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="WinQuickSwitch can change display, audio, microphone, wireless, and taskbar settings. Review each action before applying it and use the app at your own risk."
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,14,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="This is a local/private build. Contact the owner or maintainer if you need an authorized copy."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
