<Window x:Class="WinQuickSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinQuickSwitch"
        Width="760"
        Height="620"
        MinWidth="620"
        MinHeight="480"
        Background="{StaticResource PageBrush}"
        Loaded="MainWindow_Loaded"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,20">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Quick controls" />
        <TextBlock Margin="0,6,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Display, audio, and connected devices in one place." />
      </StackPanel>

      <Border Grid.Row="1" Style="{StaticResource SectionCard}">
        <StackPanel>
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Display mode" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="PC screen only, duplicate, extend, or second screen only" />
          </StackPanel>

          <WrapPanel x:Name="DisplayModeButtons"
                     Margin="0,16,0,4"
                     KeyboardNavigation.TabNavigation="Continue">
            <Button Style="{StaticResource ActionButton}"
                    Tag="PcScreenOnly"
                    Click="ApplyDisplayMode_Click"
                    Content="PC screen only"
                    ToolTip="Use the primary PC display only" />
            <Button Style="{StaticResource ActionButton}"
                    x:Name="DuplicateDisplayButton"
                    Tag="Duplicate"
                    Click="ApplyDisplayMode_Click"
                    Content="Duplicate"
                    ToolTip="Show the same desktop on each display" />
            <Button Style="{StaticResource ActionButton}"
                    x:Name="ExtendDisplayButton"
                    Tag="Extend"
                    Click="ApplyDisplayMode_Click"
                    Content="Extend"
                    ToolTip="Extend the desktop across displays" />
            <Button Style="{StaticResource ActionButton}"
                    Tag="SecondScreenOnly"
                    Click="ApplyDisplayMode_Click"
                    Content="Second screen only"
                    ToolTip="Use the external display only" />
          </WrapPanel>

          <TextBlock x:Name="DisplayStatusText"
                     Margin="0,4,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Choose a projection mode." />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource SectionCard}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Audio" />
              <TextBlock Margin="0,6,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Active endpoints and application audio sessions" />
            </StackPanel>
            <Button x:Name="RefreshAudioButton"
                    Grid.Column="1"
                    MinWidth="88"
                    MinHeight="34"
                    Padding="12,5"
                    Click="RefreshAudio_Click"
                    Content="Refresh" />
          </Grid>

          <TextBlock x:Name="AudioStatusText"
                     Margin="0,12,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Audio inventory has not been loaded." />

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Text="Playback" />
              <ListBox x:Name="PlaybackEndpointsList"
                       MinHeight="72"
                       MaxHeight="130"
                       DisplayMemberPath="DisplayLabel" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Text="Microphones" />
              <ListBox x:Name="RecordingEndpointsList"
                       MinHeight="72"
                       MaxHeight="130"
                       DisplayMemberPath="DisplayLabel" />
            </StackPanel>
          </Grid>

          <TextBlock Margin="0,14,0,6"
                     FontWeight="SemiBold"
                     Text="Active application sessions" />
          <ListView x:Name="AudioSessionsList" MinHeight="80" MaxHeight="180">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="180"
                                Header="Application"
                                DisplayMemberBinding="{Binding ApplicationName}" />
                <GridViewColumn Width="190"
                                Header="Output"
                                DisplayMemberBinding="{Binding EndpointName}" />
                <GridViewColumn Width="70"
                                Header="Volume"
                                DisplayMemberBinding="{Binding VolumeLabel}" />
                <GridViewColumn Width="60"
                                Header="Muted"
                                DisplayMemberBinding="{Binding MuteLabel}" />
              </GridView>
            </ListView.View>
          </ListView>
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Devices" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Bluetooth and wired devices currently connected" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Milestone 4" />
        </Grid>
      </Border>

      <TextBlock Grid.Row="4"
                 Margin="2,6,0,0"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 Text="Display controls and read-only audio inventory are active." />
    </Grid>
  </ScrollViewer>
</Window>
