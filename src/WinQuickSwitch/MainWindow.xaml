<Window x:Class="WinQuickSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinQuickSwitch"
        Width="660"
        MinWidth="620"
        MinHeight="560"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{StaticResource PageBrush}"
        Loaded="MainWindow_Loaded"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource SectionCard}">
        <StackPanel>
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="Display" />

          <WrapPanel x:Name="DisplayModeButtons"
                     Margin="0,12,0,2"
                     KeyboardNavigation.TabNavigation="Continue">
            <Button Style="{StaticResource ActionButton}"
                    Tag="PcScreenOnly"
                    Click="ApplyDisplayMode_Click"
                    Content="PC screen only"
                    ToolTip="Use the primary PC display only" />
            <Button Style="{StaticResource ActionButton}"
                    x:Name="DuplicateDisplayButton"
                    Tag="Duplicate"
                    Click="ApplyDisplayMode_Click"
                    Content="Duplicate"
                    ToolTip="Show the same desktop on each display" />
            <Button Style="{StaticResource ActionButton}"
                    x:Name="ExtendDisplayButton"
                    Tag="Extend"
                    Click="ApplyDisplayMode_Click"
                    Content="Extend"
                    ToolTip="Extend the desktop across displays" />
            <Button Style="{StaticResource ActionButton}"
                    Tag="SecondScreenOnly"
                    Click="ApplyDisplayMode_Click"
                    Content="Second screen only"
                    ToolTip="Use the external display only" />
          </WrapPanel>

          <TextBlock x:Name="DisplayStatusText"
                     Margin="0,4,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Choose a projection mode." />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCard}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="Audio" />
            <Button x:Name="RefreshAudioButton"
                    Grid.Column="1"
                    MinWidth="78"
                    MinHeight="32"
                    Padding="10,4"
                    Click="RefreshAudio_Click"
                    Content="Refresh" />
          </Grid>

          <TextBlock x:Name="AudioStatusText"
                     Margin="0,8,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Loading..." />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Text="Output" />
              <ListBox x:Name="PlaybackEndpointsList"
                       MinHeight="72"
                       MaxHeight="135"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid AutomationProperties.Name="{Binding Name}"
                          AutomationProperties.HelpText="{Binding ActiveRoleDescription}"
                          ToolTip="{Binding ActiveRoleDescription}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1"
                              Background="{StaticResource DefaultBadgeBrush}">
                        <Border.Style>
                          <Style TargetType="Border"
                                 BasedOn="{StaticResource EndpointBadge}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="DEFAULT" />
                      </Border>
                      <Border Grid.Column="2"
                              Background="{StaticResource CallsBadgeBrush}">
                        <Border.Style>
                          <Style TargetType="Border"
                                 BasedOn="{StaticResource EndpointBadge}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCommunicationsDefault}"
                                           Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="CALLS" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource CompactButton}"
                        Tag="PlaybackGeneral"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Default"
                        ToolTip="Use the selected playback device for normal Windows audio" />
                <Button Style="{StaticResource CompactButton}"
                        Tag="PlaybackCommunications"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Calls"
                        ToolTip="Set the selected device as Windows' calls default; apps can override it" />
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Text="Input" />
              <ListBox x:Name="RecordingEndpointsList"
                       MinHeight="72"
                       MaxHeight="135"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemTemplate="{Binding ElementName=PlaybackEndpointsList, Path=ItemTemplate}" />
              <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource CompactButton}"
                        Tag="RecordingGeneral"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Default"
                        ToolTip="Use the selected microphone for normal recording" />
                <Button Style="{StaticResource CompactButton}"
                        Tag="RecordingCommunications"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Calls"
                        ToolTip="Set the selected microphone as Windows' calls default; apps can override it" />
              </WrapPanel>
            </StackPanel>
          </Grid>

          <TextBlock Margin="0,12,0,6"
                     FontWeight="SemiBold"
                     Text="Applications" />
          <ListView x:Name="AudioSessionsList"
                    MinHeight="72"
                    MaxHeight="115"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="150"
                                Header="Application"
                                DisplayMemberBinding="{Binding ApplicationName}" />
                <GridViewColumn Width="170"
                                Header="Output"
                                DisplayMemberBinding="{Binding EndpointName}" />
                <GridViewColumn Width="190" Header="Volume">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="135" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="2"
                                LargeChange="10"
                                Tag="{Binding Id}"
                                Value="{Binding VolumePercent, Mode=OneWay}"
                                PreviewMouseLeftButtonUp="SessionVolumeSlider_Commit"
                                KeyUp="SessionVolumeSlider_KeyUp"
                                AutomationProperties.Name="{Binding ApplicationName, StringFormat=Volume for {0}}" />
                        <TextBlock Grid.Column="1"
                                   Width="42"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding VolumeLabel}" />
                      </Grid>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="65" Header="Mute">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox HorizontalAlignment="Center"
                                Tag="{Binding Id}"
                                IsChecked="{Binding IsMuted, Mode=OneWay}"
                                Click="SessionMute_Click"
                                AutomationProperties.Name="{Binding ApplicationName, StringFormat=Mute {0}}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource SectionCard}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="Devices" />
            <Button x:Name="RefreshDevicesButton"
                    Grid.Column="1"
                    MinWidth="78"
                    MinHeight="32"
                    Padding="10,4"
                    Click="RefreshDevices_Click"
                    Content="Refresh" />
          </Grid>

          <TextBlock x:Name="DeviceStatusText"
                     Margin="0,8,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Loading..." />

          <ListView x:Name="ConnectedDevicesList"
                    Margin="0,10,0,0"
                    MinHeight="80"
                    MaxHeight="145"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="225"
                                Header="Name"
                                DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Width="90"
                                Header="Connection"
                                DisplayMemberBinding="{Binding ConnectionLabel}" />
                <GridViewColumn Width="105"
                                Header="Type"
                                DisplayMemberBinding="{Binding Category}" />
                <GridViewColumn Width="95"
                                Header="Status"
                                DisplayMemberBinding="{Binding StatusLabel}" />
              </GridView>
            </ListView.View>
          </ListView>

          <WrapPanel Margin="0,10,0,0">
            <Button Style="{StaticResource CompactButton}"
                    Click="OpenBluetoothSettings_Click"
                    Content="Bluetooth settings"
                    ToolTip="Pair, disconnect, or remove a Bluetooth device in Windows Settings" />
            <Button Style="{StaticResource CompactButton}"
                    Click="OpenConnectedDevicesSettings_Click"
                    Content="Devices settings"
                    ToolTip="Manage connected devices in Windows Settings" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
