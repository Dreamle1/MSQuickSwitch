<Window x:Class="WinQuickSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinQuickSwitch"
        Width="760"
        MinWidth="620"
        MinHeight="680"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{StaticResource PageBrush}"
        Loaded="MainWindow_Loaded"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,20">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Quick controls" />
        <TextBlock Margin="0,6,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Display, audio, and connected devices in one place." />
      </StackPanel>

      <Border Grid.Row="1" Style="{StaticResource SectionCard}">
        <StackPanel>
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Display mode" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="PC screen only, duplicate, extend, or second screen only" />
          </StackPanel>

          <WrapPanel x:Name="DisplayModeButtons"
                     Margin="0,16,0,4"
                     KeyboardNavigation.TabNavigation="Continue">
            <Button Style="{StaticResource ActionButton}"
                    Tag="PcScreenOnly"
                    Click="ApplyDisplayMode_Click"
                    Content="PC screen only"
                    ToolTip="Use the primary PC display only" />
            <Button Style="{StaticResource ActionButton}"
                    x:Name="DuplicateDisplayButton"
                    Tag="Duplicate"
                    Click="ApplyDisplayMode_Click"
                    Content="Duplicate"
                    ToolTip="Show the same desktop on each display" />
            <Button Style="{StaticResource ActionButton}"
                    x:Name="ExtendDisplayButton"
                    Tag="Extend"
                    Click="ApplyDisplayMode_Click"
                    Content="Extend"
                    ToolTip="Extend the desktop across displays" />
            <Button Style="{StaticResource ActionButton}"
                    Tag="SecondScreenOnly"
                    Click="ApplyDisplayMode_Click"
                    Content="Second screen only"
                    ToolTip="Use the external display only" />
          </WrapPanel>

          <TextBlock x:Name="DisplayStatusText"
                     Margin="0,4,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Choose a projection mode." />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource SectionCard}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Audio" />
              <TextBlock Margin="0,6,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Active endpoints and application audio sessions" />
            </StackPanel>
            <Button x:Name="RefreshAudioButton"
                    Grid.Column="1"
                    MinWidth="88"
                    MinHeight="34"
                    Padding="12,5"
                    Click="RefreshAudio_Click"
                    Content="Refresh" />
          </Grid>

          <TextBlock x:Name="AudioStatusText"
                     Margin="0,12,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Select Refresh to load audio devices and active sessions." />

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Text="Playback" />
              <ListBox x:Name="PlaybackEndpointsList"
                       MinHeight="72"
                       MaxHeight="190"
                       DisplayMemberPath="DisplayLabel" />
              <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource CompactButton}"
                        Tag="PlaybackGeneral"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Set default"
                        ToolTip="Use the selected playback device for normal Windows audio" />
                <Button Style="{StaticResource CompactButton}"
                        Tag="PlaybackCommunications"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Set calls"
                        ToolTip="Use the selected playback device for communications" />
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Margin="0,0,0,6"
                         FontWeight="SemiBold"
                         Text="Microphones" />
              <ListBox x:Name="RecordingEndpointsList"
                       MinHeight="72"
                       MaxHeight="190"
                       DisplayMemberPath="DisplayLabel" />
              <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource CompactButton}"
                        Tag="RecordingGeneral"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Set default"
                        ToolTip="Use the selected microphone for normal recording" />
                <Button Style="{StaticResource CompactButton}"
                        Tag="RecordingCommunications"
                        Click="SetDefaultAudioEndpoint_Click"
                        Content="Set calls"
                        ToolTip="Use the selected microphone for communications" />
              </WrapPanel>
            </StackPanel>
          </Grid>

          <TextBlock Margin="0,8,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Select a device, then choose whether it is the normal default or the calls device." />

          <TextBlock Margin="0,14,0,6"
                     FontWeight="SemiBold"
                     Text="Active application sessions" />
          <ListView x:Name="AudioSessionsList" MinHeight="80" MaxHeight="180">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="150"
                                Header="Application"
                                DisplayMemberBinding="{Binding ApplicationName}" />
                <GridViewColumn Width="170"
                                Header="Output"
                                DisplayMemberBinding="{Binding EndpointName}" />
                <GridViewColumn Width="190" Header="Volume">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="135" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="2"
                                LargeChange="10"
                                Tag="{Binding Id}"
                                Value="{Binding VolumePercent, Mode=OneWay}"
                                PreviewMouseLeftButtonUp="SessionVolumeSlider_Commit"
                                KeyUp="SessionVolumeSlider_KeyUp"
                                AutomationProperties.Name="{Binding ApplicationName, StringFormat=Volume for {0}}" />
                        <TextBlock Grid.Column="1"
                                   Width="42"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding VolumeLabel}" />
                      </Grid>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="65" Header="Mute">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox HorizontalAlignment="Center"
                                Tag="{Binding Id}"
                                IsChecked="{Binding IsMuted, Mode=OneWay}"
                                Click="SessionMute_Click"
                                AutomationProperties.Name="{Binding ApplicationName, StringFormat=Mute {0}}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Devices" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Bluetooth and wired devices currently connected" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="Milestone 4" />
        </Grid>
      </Border>

      <TextBlock Grid.Row="4"
                 Margin="2,6,0,0"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 Text="Display and audio controls are active." />
    </Grid>
  </ScrollViewer>
</Window>
