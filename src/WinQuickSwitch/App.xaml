<Application x:Class="WinQuickSwitch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#101318" />
    <SolidColorBrush x:Key="CardBrush" Color="#191D24" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A303A" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AEB6C2" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="MinWidth" Value="136" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
