<UserControl x:Class="WinQuickSwitch.Features.SharedUi.DevicesFeatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:WinQuickSwitch.Features.SharedUi"
             MinWidth="0"
             AutomationProperties.Name="Device controls">
  <DockPanel>
    <shared:SharedRefreshErrorBanner DockPanel.Dock="Top" />
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="FeatureTitleText"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Text="Devices" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Button x:Name="RefreshButton"
              Grid.Column="1"
              MinWidth="78"
              MinHeight="40"
              Margin="8,0,0,0"
              Command="{Binding RefreshCommand}"
              Content="Refresh"
              AutomationProperties.Name="Refresh devices" />
    </Grid>

    <UniformGrid Grid.Row="1" Margin="0,12,0,0" Columns="2">
      <ToggleButton Style="{StaticResource DisplayModeToggle}"
                    IsChecked="{Binding IsWiFiOn, Mode=OneWay}"
                    IsEnabled="{Binding IsWiFiAvailable}"
                    Command="{Binding ToggleWiFiCommand}"
                    Content="{Binding WiFiLabel}"
                    AutomationProperties.Name="Toggle Wi-Fi" />
      <ToggleButton Style="{StaticResource DisplayModeToggle}"
                    IsChecked="{Binding IsBluetoothOn, Mode=OneWay}"
                    IsEnabled="{Binding IsBluetoothAvailable}"
                    Command="{Binding ToggleBluetoothCommand}"
                    Content="{Binding BluetoothLabel}"
                    AutomationProperties.Name="Toggle Bluetooth" />
    </UniformGrid>

    <TextBlock Grid.Row="2"
               Margin="0,10,0,6"
               FontWeight="SemiBold"
               Text="{Binding DeviceCountText}" />

    <ListView Grid.Row="3"
              MinHeight="190"
              MaxHeight="440"
              ItemsSource="{Binding Devices}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Type ListViewItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          <Setter Property="AutomationProperties.HelpText" Value="{Binding StatusLabel}" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Width="250" Header="Name" DisplayMemberBinding="{Binding Name}" />
          <GridViewColumn Width="110" Header="Connection" DisplayMemberBinding="{Binding ConnectionLabel}" />
          <GridViewColumn Width="150" Header="Type" DisplayMemberBinding="{Binding Category}" />
          <GridViewColumn Width="110" Header="Status" DisplayMemberBinding="{Binding StatusLabel}" />
        </GridView>
      </ListView.View>
    </ListView>

    <WrapPanel Grid.Row="4" Margin="0,12,0,0">
      <Button Style="{StaticResource CompactButton}"
              Command="{Binding OpenWiFiSettingsCommand}"
              Content="Wi-Fi settings" />
      <Button Style="{StaticResource CompactButton}"
              Command="{Binding OpenBluetoothSettingsCommand}"
              Content="Bluetooth settings" />
      <Button Style="{StaticResource CompactButton}"
              Command="{Binding OpenAirplaneModeSettingsCommand}"
              Content="Airplane mode" />
      <Button Style="{StaticResource CompactButton}"
              Command="{Binding OpenNetworkSettingsCommand}"
              Content="Network settings" />
      <Button Style="{StaticResource CompactButton}"
              Command="{Binding OpenConnectedDevicesSettingsCommand}"
              Content="Connected-device settings" />
      <Button Style="{StaticResource CompactButton}"
              Command="{Binding OpenFloatingDevicesCommand}"
              Content="Open floating Devices widget" />
    </WrapPanel>
    </Grid>
  </DockPanel>
</UserControl>
