<UserControl x:Class="WinQuickSwitch.Features.SharedUi.SharedRefreshErrorBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding RefreshErrorVisibility}"
             AutomationProperties.LiveSetting="Assertive">
  <Border Margin="0,10,0,0"
          Padding="10"
          Background="{DynamicResource PageBrush}"
          BorderBrush="{DynamicResource SelectionBrush}"
          BorderThickness="2"
          CornerRadius="6">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center"
                 Text="{Binding RefreshErrorMessage}"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Feature refresh failed" />
      <Button Grid.Column="1"
              MinWidth="72"
              MinHeight="40"
              Margin="10,0,0,0"
              Command="{Binding RetryRefreshCommand}"
              Content="Retry"
              AutomationProperties.Name="Retry feature refresh" />
    </Grid>
  </Border>
</UserControl>
