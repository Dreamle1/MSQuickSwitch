<UserControl x:Class="WinQuickSwitch.Features.SharedUi.ProfilesFeatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:WinQuickSwitch.Features.SharedUi"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="720"
             d:DesignHeight="820"
             AutomationProperties.Name="Profile controls">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Focusable="False">
    <StackPanel Margin="2">
      <shared:SharedRefreshErrorBanner />
      <TextBlock FontSize="17"
                 FontWeight="SemiBold"
                 Text="{Binding Title, FallbackValue=Profiles}" />
      <TextBlock Margin="0,5,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="{Binding Description, FallbackValue=Save the settings that define a desk mode. Unchecked items stay unchanged when you apply it.}"
                 TextWrapping="Wrap" />

      <Border Margin="0,14,0,0"
              Padding="12"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <StackPanel>
          <TextBlock FontSize="14"
                     FontWeight="SemiBold"
                     Text="{Binding EditorHeading, FallbackValue=Capture current setup}" />
          <TextBlock Margin="0,8,0,0" Text="Profile name" />
          <TextBox Margin="0,4,0,0"
                   Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Profile name" />

          <UniformGrid Margin="0,10,0,0" Columns="2">
            <CheckBox Margin="0,0,8,8"
                      IsChecked="{Binding IncludeDisplay, Mode=TwoWay}"
                      Content="Display mode" />
            <CheckBox Margin="0,0,0,8"
                      IsChecked="{Binding IncludeTaskbar, Mode=TwoWay}"
                      Content="Taskbar" />
            <CheckBox Margin="0,0,8,8"
                      IsChecked="{Binding IncludePlayback, Mode=TwoWay}"
                      Content="Playback" />
            <CheckBox Margin="0,0,0,8"
                      IsChecked="{Binding IncludeRecording, Mode=TwoWay}"
                      Content="Recording" />
            <CheckBox Margin="0,0,8,0"
                      IsChecked="{Binding IncludeMasterVolume, Mode=TwoWay}"
                      Content="Master volume" />
            <CheckBox IsChecked="{Binding IncludeMicrophoneMute, Mode=TwoWay}"
                      Content="Microphone mute" />
          </UniformGrid>

          <TextBlock Margin="0,12,0,0"
                     FontWeight="SemiBold"
                     Text="Favorite targets" />
          <TextBlock Margin="0,3,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Optionally use a saved favorite when capturing audio."
                     TextWrapping="Wrap" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0">
              <TextBlock Text="Playback favorite (optional)" />
              <ComboBox Margin="0,4,0,0"
                        ItemsSource="{Binding PlaybackFavoriteChoices}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedPlaybackFavorite, Mode=TwoWay}"
                        AutomationProperties.Name="Playback favorite for this profile" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Text="Microphone favorite (optional)" />
              <ComboBox Margin="0,4,0,0"
                        ItemsSource="{Binding RecordingFavoriteChoices}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedRecordingFavorite, Mode=TwoWay}"
                        AutomationProperties.Name="Microphone favorite for this profile" />
            </StackPanel>
          </Grid>

          <CheckBox Margin="0,10,0,0"
                    IsChecked="{Binding PinAfterSaving, Mode=TwoWay}"
                    Content="Pin after saving" />
          <WrapPanel Margin="0,10,0,0">
            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding SaveCommand}"
                    Content="{Binding SaveButtonText, FallbackValue=Save current setup}" />
            <Button Command="{Binding CancelEditCommand}"
                    Content="Cancel edit">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Command="{Binding UndoCommand}"
                    Content="Undo last profile">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CanUndo}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Margin="0,14,0,0"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Text="Saved profiles" />
      <TextBlock Margin="0,5,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="{Binding EmptyMessage, FallbackValue=No profiles saved yet.}"
                 TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasProfiles}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <ItemsControl Margin="0,8,0,0"
                    ItemsSource="{Binding Profiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,8"
                    Padding="10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                  <DockPanel LastChildFill="False">
                    <TextBlock Margin="0,0,8,0"
                               FontWeight="SemiBold"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}" />
                    <Border Padding="5,1"
                            Background="{DynamicResource SelectionBrush}"
                            CornerRadius="4">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Foreground="{DynamicResource SelectionTextBrush}"
                                 FontSize="10"
                                 Text="PINNED" />
                    </Border>
                  </DockPanel>
                  <TextBlock Margin="0,4,0,0"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             Text="{Binding Summary}"
                             TextWrapping="Wrap" />
                  <TextBlock Margin="0,3,0,0"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             Text="{Binding LastResultMessage}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        MinWidth="96"
                        MinHeight="40"
                        Command="{Binding ApplyCommand}"
                        Content="Apply"
                        ToolTip="Apply this profile"
                        AutomationProperties.Name="{Binding Name, StringFormat=Apply profile {0}}" />
                <WrapPanel Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,9,0,0">
                  <Button Style="{StaticResource CompactButton}"
                          Command="{Binding EditCommand}"
                          Content="Edit"
                          AutomationProperties.Name="{Binding Name, StringFormat=Edit profile {0}}" />
                  <Button Style="{StaticResource CompactButton}"
                          Command="{Binding DuplicateCommand}"
                          Content="Copy"
                          AutomationProperties.Name="{Binding Name, StringFormat=Copy profile {0}}" />
                  <Button Style="{StaticResource CompactButton}"
                          Command="{Binding TogglePinCommand}"
                          Content="{Binding PinButtonText, FallbackValue=Pin}"
                          AutomationProperties.Name="{Binding Name, StringFormat=Change pinned state for profile {0}}" />
                  <Button Style="{StaticResource CompactButton}"
                          Command="{Binding CaptureShortcutCommand}"
                          Content="{Binding ShortcutText, FallbackValue=Set shortcut}"
                          ToolTip="Set this profile shortcut"
                          AutomationProperties.Name="{Binding Name, StringFormat=Set shortcut for profile {0}}" />
                  <Button Style="{StaticResource CompactButton}"
                          Command="{Binding ClearShortcutCommand}"
                          Content="Unset"
                          AutomationProperties.Name="{Binding Name, StringFormat=Unset shortcut for profile {0}}" />
                  <Button Style="{StaticResource CompactButton}"
                          Command="{Binding DeleteCommand}"
                          Content="Delete"
                          AutomationProperties.Name="{Binding Name, StringFormat=Delete profile {0}}" />
                </WrapPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Margin="0,6,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="{Binding StatusMessage, FallbackValue=Profiles are saved locally.}"
                 TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
