<UserControl x:Class="WinQuickSwitch.Features.SharedUi.AboutFeatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:WinQuickSwitch.Features.SharedUi"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="620"
             AutomationProperties.Name="About WinQuickSwitch">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Focusable="False">
    <StackPanel Margin="2">
      <shared:SharedRefreshErrorBanner />
      <TextBlock FontSize="17"
                 FontWeight="SemiBold"
                 Text="{Binding Title, FallbackValue=About WinQuickSwitch}" />
      <TextBlock Margin="0,5,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="{Binding Description}"
                 TextWrapping="Wrap" />

      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock FontWeight="SemiBold" Text="Edition" />
        <TextBlock Grid.Column="1"
                   Text="{Binding EditionName, FallbackValue=WinQuickSwitch}" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,0"
                   FontWeight="SemiBold"
                   Text="Version" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,6,0,0"
                   Text="{Binding Version, FallbackValue=Unknown}" />
        <TextBlock Grid.Row="2"
                   Margin="0,6,0,0"
                   FontWeight="SemiBold"
                   Text="Publisher" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Margin="0,6,0,0"
                   Text="{Binding PublisherName, FallbackValue=Dreamle}" />
      </Grid>

      <Border Margin="0,14,0,0"
              Padding="12"
              Background="{DynamicResource SelectionBrush}"
              CornerRadius="6">
        <StackPanel>
          <TextBlock FontWeight="SemiBold"
                     Foreground="{DynamicResource SelectionTextBrush}"
                     Text="{Binding LicenseHeading, FallbackValue=Licensed software}" />
          <TextBlock Margin="0,5,0,0"
                     Foreground="{DynamicResource SelectionTextBrush}"
                     Text="{Binding LicenseText}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,5,0,0"
                     Foreground="{DynamicResource SelectionTextBrush}"
                     Text="{Binding SharingText}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,5,0,0"
                     Foreground="{DynamicResource SelectionTextBrush}"
                     Text="{Binding LocalDataText}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Margin="0,14,0,0"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Text="Privacy" />
      <TextBlock Margin="0,5,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="{Binding PrivacySummary, FallbackValue=WinQuickSwitch stores preferences locally. It does not sell personal information. Device and audio names are displayed only to provide the requested controls.}"
                 TextWrapping="Wrap" />

      <TextBlock Margin="0,14,0,0"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Text="Responsible use" />
      <TextBlock Margin="0,5,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="{Binding ResponsibleUseText}"
                 TextWrapping="Wrap" />

      <WrapPanel Margin="0,14,0,0">
        <Button Style="{StaticResource ActionButton}"
                Command="{Binding OpenEulaCommand}"
                Content="View license"
                AutomationProperties.Name="Open End User License Agreement" />
        <Button Style="{StaticResource ActionButton}"
                Command="{Binding OpenPrivacyCommand}"
                Content="View privacy policy"
                AutomationProperties.Name="Open privacy policy" />
      </WrapPanel>

      <TextBlock Margin="0,8,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
