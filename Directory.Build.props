<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <!-- Keep every executable, package, and published artifact on the same
         release number.  Store packages use the four-part value; the SDK
         also derives the normal three-part display version from it. -->
    <WinQuickSwitchReleaseVersion Condition="'$(WinQuickSwitchReleaseVersion)' == ''">1.1.1.0</WinQuickSwitchReleaseVersion>
    <Version Condition="'$(Version)' == ''">$(WinQuickSwitchReleaseVersion)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(WinQuickSwitchReleaseVersion)</PackageVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(WinQuickSwitchReleaseVersion)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(WinQuickSwitchReleaseVersion)</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(WinQuickSwitchReleaseVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
